{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeReview",
  "type": "object",
  "required": ["creative_id", "scores", "total_score", "decision", "issues"],
  "properties": {
    "creative_id": {"type": "string"},
    "scores": {
      "type": "object",
      "required": ["fact_consistency", "target_fit", "message_strength", "copy_quality", "readability", "composition", "brand_fit", "image_integrity", "format_compliance"],
      "properties": {
        "fact_consistency": {"type": "number", "minimum": 0, "maximum": 20},
        "target_fit": {"type": "number", "minimum": 0, "maximum": 15},
        "message_strength": {"type": "number", "minimum": 0, "maximum": 15},
        "copy_quality": {"type": "number", "minimum": 0, "maximum": 15},
        "readability": {"type": "number", "minimum": 0, "maximum": 10},
        "composition": {"type": "number", "minimum": 0, "maximum": 10},
        "brand_fit": {"type": "number", "minimum": 0, "maximum": 5},
        "image_integrity": {"type": "number", "minimum": 0, "maximum": 5},
        "format_compliance": {"type": "number", "minimum": 0, "maximum": 5}
      },
      "additionalProperties": false
    },
    "total_score": {"type": "number", "minimum": 0, "maximum": 100},
    "decision": {"enum": ["reviewer_pass", "revision", "redesign", "blocked"]},
    "critical_issue": {"type": "boolean"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "description", "root_cause", "return_to_agent"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "description": {"type": "string"},
          "root_cause": {"type": "string"},
          "return_to_agent": {"type": "string"},
          "revision_instruction": {"type": ["string", "null"]}
        }
      }
    }
  },
  "additionalProperties": false
}
