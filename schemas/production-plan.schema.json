{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionPlan",
  "type": "object",
  "required": ["status", "requested_quantity", "candidate_axes", "selected_axes", "creative_groups", "missing_information"],
  "properties": {
    "status": {"enum": ["ready_for_direction", "needs_clarification", "blocked"]},
    "requested_quantity": {"type": "integer", "minimum": 1, "maximum": 100},
    "candidate_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis_id", "theme", "target", "message", "trace_to_facts"],
        "properties": {
          "axis_id": {"type": "string"},
          "theme": {"type": "string"},
          "target": {"type": "string"},
          "message": {"type": "string"},
          "trace_to_facts": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "integer", "minimum": 1},
          "selected": {"type": "boolean"},
          "reject_reason": {"type": ["string", "null"]}
        }
      }
    },
    "selected_axes": {"type": "array", "items": {"type": "string"}},
    "creative_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["creative_group_id", "theme", "target", "message", "quantity", "formats", "trace_to_facts"],
        "properties": {
          "creative_group_id": {"type": "string"},
          "theme": {"type": "string"},
          "target": {"type": "string"},
          "message": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "formats": {"type": "array", "items": {"type": "string"}},
          "trace_to_facts": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "missing_information": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
