{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptPackage",
  "type": "object",
  "required": ["creative_group_id", "prompt", "overlay_text", "locked_requirements", "negative_requirements"],
  "properties": {
    "creative_group_id": {"type": "string"},
    "prompt": {"type": "string"},
    "negative_prompt": {"type": ["string", "null"]},
    "overlay_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": {"enum": ["main_copy", "sub_copy", "cta", "fact", "brand"]},
          "text": {"type": "string"},
          "placement": {"type": ["string", "null"]}
        }
      }
    },
    "locked_requirements": {"type": "array", "items": {"type": "string"}},
    "negative_requirements": {"type": "array", "items": {"type": "string"}},
    "size_variations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "prompt_delta"],
        "properties": {
          "format": {"type": "string"},
          "prompt_delta": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
