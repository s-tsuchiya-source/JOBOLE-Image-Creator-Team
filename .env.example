# ============================================================
# Google Drive / Storage
# ============================================================
PROJECTS_ROOT=G:/共有ドライブ/ジョブオレチーム/ジョブオレチーム/JOBOLE-Image-Creator-Team/projects
KNOWLEDGE_ROOT=G:/共有ドライブ/ジョブオレチーム/ジョブオレチーム/JOBOLE-Image-Creator-Team/knowledge
ORIGINAL_IMAGE_ROOT=G:/共有ドライブ/ジョブオレチーム/ジョブオレチーム/JOBOLE-Image-Creator-Team/original_image
LOCAL_TEMP_ROOT=./tmp

# ============================================================
# Token-efficient Phase 1 context / benchmark settings
# ============================================================
REFERENCE_SHORTLIST_MAX=3
REFERENCE_CONTACT_SHEET_MAX=24
CREATIVE_ROUTE_MAX=2
FACT_CHIP_MAX=3
REVISION_MAX=2
AGENT_OUTPUT_MODE=compact_json
BENCHMARK_REFERENCE_REQUIRED=true

# ============================================================
# Design Spec / Layout Engine
# ============================================================
# Claude Creative Director decides layout_family / semantic line breaks / emphasis.
# Python renders the approved Design Spec exactly; the image model never renders required text.
DESIGN_SPEC_REQUIRED=true
DEFAULT_LAYOUT_FAMILY=concept_message
LAYOUT_CONFIG_PATH=configs/layouts.yaml

# ============================================================
# Text AI: NO API KEYS
# ============================================================
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_MODEL=opus
CLAUDE_CLI_MAX_TURNS=4
CLAUDE_CLI_TIMEOUT_SEC=600

CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_TIMEOUT_SEC=900

# ============================================================
# Image generation backend
# ============================================================
IMAGE_BACKEND=openvino_ovms

OPENVINO_IMAGE_API_URL=http://127.0.0.1:8000
OPENVINO_IMAGE_MODEL=OpenVINO/stable-diffusion-v1-5-int8-ov
OPENVINO_IMAGE_STEPS=10
OPENVINO_IMAGE_GENERATION_SIZE=512x512
OPENVINO_IMAGE_TIMEOUT_SEC=1200

LOCAL_IMAGE_API_URL=http://127.0.0.1:7860
LOCAL_IMAGE_MODEL=local-loaded-checkpoint
LOCAL_IMAGE_STEPS=28
LOCAL_IMAGE_CFG_SCALE=6.5
LOCAL_IMAGE_SAMPLER=DPM++ 2M
LOCAL_IMAGE_MAX_SIDE=1024
LOCAL_IMAGE_TIMEOUT_SEC=600

# OpenAI Image API (ONLY required when IMAGE_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=high

# ============================================================
# Japanese typography
# ============================================================
JAPANESE_FONT_PATH=C:/Windows/Fonts/YuGothB.ttc
JAPANESE_BOLD_FONT_PATH=C:/Windows/Fonts/YuGothB.ttc
JAPANESE_REGULAR_FONT_PATH=C:/Windows/Fonts/YuGothR.ttc

# ============================================================
# Runtime
# ============================================================
PRODUCTION_MODE=live

USDJPY_RATE=
OPENAI_IMAGE_ESTIMATED_USD_PER_GENERATION=
