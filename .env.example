# Google Drive projects root (Windows + Google Drive for desktop example)
PROJECTS_ROOT=G:/マイドライブ/JOBOLE-Image-Creator-Team/projects

# Shared knowledge root for Golden / Rejected creatives and brand/media rules
KNOWLEDGE_ROOT=G:/マイドライブ/JOBOLE-Image-Creator-Team/knowledge

# Optional local temp directory
LOCAL_TEMP_ROOT=./tmp

# Anthropic / Claude specialist agents
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI / Codex CCO and image generation
OPENAI_API_KEY=
OPENAI_CCO_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=high

# Exact Japanese text overlay
# Windows example: C:/Windows/Fonts/YuGothB.ttc
JAPANESE_FONT_PATH=

# Runtime
# dry-run: no paid AI/image API calls
# live: execute Claude + Codex CCO + image generation
PRODUCTION_MODE=dry-run

# Cost tracking (fill with current provider pricing before live production)
# These values are intentionally not hard-coded because provider pricing and FX change.
USDJPY_RATE=
ANTHROPIC_INPUT_USD_PER_M=
ANTHROPIC_OUTPUT_USD_PER_M=
OPENAI_CCO_INPUT_USD_PER_M=
OPENAI_CCO_OUTPUT_USD_PER_M=
OPENAI_IMAGE_ESTIMATED_USD_PER_GENERATION=
