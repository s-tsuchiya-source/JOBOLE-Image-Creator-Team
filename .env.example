# Google Drive projects root (Windows + Google Drive for desktop example)
PROJECTS_ROOT=G:/マイドライブ/JOBOLE-Image-Creator-Team/projects

# Shared knowledge root for Golden / Rejected creatives and brand/media rules
KNOWLEDGE_ROOT=G:/マイドライブ/JOBOLE-Image-Creator-Team/knowledge

# Optional local temp directory
LOCAL_TEMP_ROOT=./tmp

# ============================================================
# Text AI: NO API KEYS
# ============================================================
# Claude specialists use locally installed Claude Code and its subscription login.
# Do NOT set ANTHROPIC_API_KEY for this workflow.
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_MODEL=opus
CLAUDE_CLI_MAX_TURNS=4
CLAUDE_CLI_TIMEOUT_SEC=600

# Codex CCO uses locally installed Codex CLI and the ChatGPT account already
# signed in to Codex. OPENAI_API_KEY is stripped from Codex child processes.
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_TIMEOUT_SEC=900

# ============================================================
# Image generation backend
# ============================================================
# Intel Windows first test: openvino_ovms -> local Intel CPU/GPU, no API charge
# NVIDIA/other WebUI:       local_webui  -> local WebUI, no API charge
# Production cloud:         openai       -> OpenAI Image API only
IMAGE_BACKEND=openvino_ovms

# Intel OpenVINO Model Server (recommended for Intel Iris Xe first test)
OPENVINO_IMAGE_API_URL=http://127.0.0.1:8000
OPENVINO_IMAGE_MODEL=OpenVINO/stable-diffusion-v1-5-int8-ov
OPENVINO_IMAGE_STEPS=10
OPENVINO_IMAGE_GENERATION_SIZE=512x512
OPENVINO_IMAGE_TIMEOUT_SEC=1200

# AUTOMATIC1111 / Forge compatible API (optional alternative)
LOCAL_IMAGE_API_URL=http://127.0.0.1:7860
LOCAL_IMAGE_MODEL=local-loaded-checkpoint
LOCAL_IMAGE_STEPS=28
LOCAL_IMAGE_CFG_SCALE=6.5
LOCAL_IMAGE_SAMPLER=DPM++ 2M
LOCAL_IMAGE_MAX_SIDE=1024
LOCAL_IMAGE_TIMEOUT_SEC=600

# OpenAI Image API (ONLY required when IMAGE_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=high

# Exact Japanese text overlay
# Windows example: C:/Windows/Fonts/YuGothB.ttc
JAPANESE_FONT_PATH=

# Runtime
# dry-run: validate only, no AI/image generation
# live: use logged-in Claude Code + Codex CLI + selected image backend
PRODUCTION_MODE=dry-run

# Cost tracking for OpenAI image backend only.
# Not required for openvino_ovms/local_webui.
USDJPY_RATE=
OPENAI_IMAGE_ESTIMATED_USD_PER_GENERATION=
