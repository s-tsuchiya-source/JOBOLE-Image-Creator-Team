# ============================================================
# Google Drive / Storage
# ============================================================
# Official project root for this team.
PROJECTS_ROOT=G:/共有ドライブ/ジョブオレチーム/ジョブオレチーム/JOBOLE-Image-Creator-Team/projects

# Shared knowledge root for Golden / Rejected creatives and brand/media rules.
KNOWLEDGE_ROOT=G:/共有ドライブ/ジョブオレチーム/ジョブオレチーム/JOBOLE-Image-Creator-Team/knowledge

# Human-curated creative benchmark library. Codex CCO must consider this before
# approving a creative direction. Python only indexes/contact-sheets it; Python
# never decides which sample is creatively best.
ORIGINAL_IMAGE_ROOT=G:/共有ドライブ/ジョブオレチーム/ジョブオレチーム/JOBOLE-Image-Creator-Team/original_image

# Optional local temp directory. Formal deliverables must NOT be stored here.
LOCAL_TEMP_ROOT=./tmp

# ============================================================
# Token-efficient Phase 1 context / benchmark settings
# ============================================================
# Max benchmark samples Codex should carry into the Creative Director call.
REFERENCE_SHORTLIST_MAX=3

# Max thumbnails per generated contact sheet page.
REFERENCE_CONTACT_SHEET_MAX=24

# Creative Director should compare only a small number of genuinely different routes.
CREATIVE_ROUTE_MAX=2
FACT_CHIP_MAX=3

# Root-cause revision only. Do not re-run every agent for a local issue.
REVISION_MAX=2

# Use compact machine-prepared context first; raw source is fallback for ambiguity.
AGENT_OUTPUT_MODE=compact_json
BENCHMARK_REFERENCE_REQUIRED=true

# ============================================================
# Text AI: NO API KEYS
# ============================================================
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_MODEL=opus
CLAUDE_CLI_MAX_TURNS=4
CLAUDE_CLI_TIMEOUT_SEC=600

CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_TIMEOUT_SEC=900

# ============================================================
# Image generation backend
# ============================================================
# Intel Windows test: openvino_ovms -> local Intel CPU/GPU
# NVIDIA/other WebUI: local_webui -> local WebUI
# Production cloud: openai -> OpenAI Image API only
IMAGE_BACKEND=openvino_ovms

# Intel OpenVINO Model Server
OPENVINO_IMAGE_API_URL=http://127.0.0.1:8000
OPENVINO_IMAGE_MODEL=OpenVINO/stable-diffusion-v1-5-int8-ov
OPENVINO_IMAGE_STEPS=10
OPENVINO_IMAGE_GENERATION_SIZE=512x512
OPENVINO_IMAGE_TIMEOUT_SEC=1200

# AUTOMATIC1111 / Forge compatible API (optional)
LOCAL_IMAGE_API_URL=http://127.0.0.1:7860
LOCAL_IMAGE_MODEL=local-loaded-checkpoint
LOCAL_IMAGE_STEPS=28
LOCAL_IMAGE_CFG_SCALE=6.5
LOCAL_IMAGE_SAMPLER=DPM++ 2M
LOCAL_IMAGE_MAX_SIDE=1024
LOCAL_IMAGE_TIMEOUT_SEC=600

# OpenAI Image API (ONLY required when IMAGE_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=high

# ============================================================
# Japanese typography
# ============================================================
# Legacy/fallback font. Existing .env files may keep only this value.
JAPANESE_FONT_PATH=C:/Windows/Fonts/YuGothB.ttc

# Optional explicit weights for more attractive hierarchy.
# If blank, the renderer automatically searches installed Windows fonts.
JAPANESE_BOLD_FONT_PATH=C:/Windows/Fonts/YuGothB.ttc
JAPANESE_REGULAR_FONT_PATH=C:/Windows/Fonts/YuGothR.ttc

# ============================================================
# Runtime
# ============================================================
# Phase 1 orchestration is driven by VSCode Codex, not by Python run_production.
PRODUCTION_MODE=live

# Cost tracking for OpenAI image backend only.
USDJPY_RATE=
OPENAI_IMAGE_ESTIMATED_USD_PER_GENERATION=
